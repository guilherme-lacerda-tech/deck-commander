services:
  romm:
    image: "{{ romm_image | default('rommapp/romm:latest') }}"
    environment:
      DB_HOST: db
      DB_NAME: romm
      DB_USER: romm
      DB_PASSWD: {{ romm_db_pass | to_json }}
      ROMM_AUTH_SECRET_KEY: {{ romm_auth_secret | to_json }}
    volumes:
      - "{{ media_root }}/library:/romm/library"
      - "{{ media_root }}/assets:/romm/assets"
      - "{{ media_root }}/config:/romm/config"
    ports: ["127.0.0.1:8080:8080"]
    networks: [frontend, database]
  db:
    image: mariadb:11
    environment:
      MARIADB_DATABASE: romm
      MARIADB_USER: romm
      MARIADB_PASSWORD: {{ romm_db_pass | to_json }}
      MARIADB_RANDOM_ROOT_PASSWORD: 'yes'
    volumes: ["{{ media_root }}/db:/var/lib/mysql"]
    networks: [database]
  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    volumes: ["{{ media_root }}/prowlarr:/config"]
    networks: [apps]
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    volumes: ["{{ media_root }}/qbittorrent:/config", "{{ media_root }}/downloads:/downloads"]
    networks: [apps]
  romarr:
    image: {{ romarr_image | to_json }}
    volumes: ["{{ media_root }}/romarr:/config", "{{ media_root }}/library:/roms", "{{ media_root }}/downloads:/downloads"]
    networks: [apps, frontend]
networks:
  frontend: {}
  apps: {}
  database:
    internal: true
